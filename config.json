    { "match": "haiku-5-5",  "input": 0.10, "output": 0.50, "cacheRead": 0.01 },
    { "match": "haiku-4-5",  "input": 1,    "output": 5,    "cacheRead": 0.10 },
    { "match": "haiku",      "input": 0.80, "output": 4,    "cacheRead": 0.08 }
